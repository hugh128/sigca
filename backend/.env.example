# --- Servidor ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017/sigca
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sigca
MONGODB_URI=mongodb://127.0.0.1:27017/sigca

# --- JWT ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Peticiones por IP cada 15 minutos (opcional; por defecto 1000)
# RATE_LIMIT_GENERAL=1000

# --- Almacenamiento de imagenes ---
# local: guarda en la carpeta uploads/ (no necesita cuentas externas; ideal para desarrollo y para
#        que cualquiera pueda correr el proyecto).
# r2:    guarda en Cloudflare R2; en la base de datos solo queda la URL.
STORAGE_DRIVER=local
# URL publica de esta API (modo local). Por defecto http://localhost:<PORT>
# API_PUBLIC_URL=http://localhost:4000

# Solo si STORAGE_DRIVER=r2 (ver la seccion "Cloudflare R2" del README):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
