{
  "name": "sigca-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SIGCA - API REST (Express + TypeScript + MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "db:start": "node scripts/mongodb-local.mjs start",
    "db:status": "node scripts/mongodb-local.mjs status",
    "db:stop": "node scripts/mongodb-local.mjs stop",
    "db:migrate": "node scripts/migrar-mongodb-local.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node scripts/verificar-integracion.mjs",
    "seed": "tsx src/seed/seed.ts",
    "test:r2": "tsx src/scripts/probarDriverR2.ts",
    "storage:probar": "tsx src/scripts/probarStorage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
